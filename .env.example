# MongoDB
MONGODB_URI=mongodb://localhost:27017/ustad_ai

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (media uploads - optional for MVP, falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mock authentication (no real SMS provider)
# When true, the OTP API returns the generated OTP in the response so the demo can auto-approve
MOCK_OTP_ENABLED=true