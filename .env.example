# MongoDB
MONGODB_URI=mongodb://localhost:27017/ustad_ai

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (media uploads - optional for MVP, falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Landing voice understanding (AssemblyAI Urdu transcription)
# Voice capture falls back to a message asking for text/photo when unset
ASSEMBLYAI_API_KEY=

# Gemini job understanding
# Analyse falls back to the built-in keyword engine when unset
GEMINI_API_KEY=